# Copy this file to ~/.cloudflared/config.yml and replace the tunnel UUID.
# Create the tunnel and DNS routes with:
#   cloudflared tunnel login
#   cloudflared tunnel create esl-local
#   cloudflared tunnel route dns esl-local esl.example.com
#   cloudflared tunnel route dns esl-local www.esl.example.com
#   cloudflared tunnel route dns esl-local cloud.esl.example.com
#   cloudflared tunnel route dns esl-local docs.esl.example.com
#   cloudflared tunnel route dns esl-local status.esl.example.com

tunnel: REPLACE_WITH_TUNNEL_UUID
credentials-file: /etc/cloudflared/REPLACE_WITH_TUNNEL_UUID.json

ingress:
  - hostname: esl.example.com
    service: http://server:80
  - hostname: www.esl.example.com
    service: http://server:80
  - hostname: cloud.esl.example.com
    service: http://server:80
  - hostname: docs.esl.example.com
    service: http://server:80
  - hostname: status.esl.example.com
    service: http://server:80
  - service: http_status:404
