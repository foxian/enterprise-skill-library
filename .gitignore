node_modules/
packages/*/dist/
.superpowers/
.worktrees/
.env

# Local data directory (default ESL bind-mount location)
data/

# 生产运维产物（ADR-0047）：备份归档（含秘密，必须留在服务器上）
backups/

# 实例层配置（ADR-0058 / ADR-0060）：自定义域名路由、TLS 证书与 Tunnel
# 都属于具体实例，不属于公开产品仓库
nginx-conf.d/
letsencrypt/
docker/cloudflared/
docker-compose.tunnel.yml
docker-compose.prod.tls.yml
.tls-domain

# Playwright E2E 运行产物(.auth 含会话 storageState)
.auth/
test-results/
playwright-report/
blob-report/

# 本地工具 / Agent 工作区(因人而异,不属于项目内容)
.playwright-mcp/
.agents/
.claude/
.mcp.json

# 本地 issue tracker / 工作区与 smoke 产物(可能含真实凭据),均不纳入版本控制
.scratch/

packages/*/src/**/*.js
packages/*/src/**/*.d.ts
# ESL managed (do not edit)
.skills/
.skills.json
.skills-lock.json
.agents/skills/
.trae/skills/

