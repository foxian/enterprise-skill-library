GITEA_ADMIN_USERNAME=eslroot
GITEA_ADMIN_PASSWORD=change-this-admin-password
GITEA_ADMIN_TOKEN_FILE=/bootstrap/gitea-admin-token
# Base directory for persistent data on the host (bind-mounted into api/gitea/secrets)
# Defaults to ./data (relative to the compose file)
ESL_DATA_DIR=./data
# Container-internal DB path (points into the mounted /data); not a host path
DATABASE_PATH=/data/esl.db
ESL_PASSWORD_MIN_LENGTH=12
ESL_APPLICATION_ENCRYPTION_KEY=replace-with-64-hex-characters
# Seed sample skill metadata (@myorg/my-skill) at API startup; set true in development
ESL_AUTO_SEED=false
# Deployment mode (single | multi, default multi). In single mode only the
# default organization's members can sign in and public organization
# registration is rejected; multi mode is the default for skill-cloud providers
# and suits enterprise self-deployment (see docs/adr/0022).
ESL_DEPLOYMENT_MODE=multi
# Default-organization bootstrap declarations (ADR-0022): the default
# organization name and its organization-admin initial password. Bootstrap
# provisions this organization directly on startup (no registration flow) and
# sets it as the default org. Required as a pair when mode is single; optional
# as a pair in multi mode (declared -> provisioned, omitted -> empty start).
# ESL_DEFAULT_ORG=acme
# ESL_ORG_ADMIN_PASSWORD=change-this-org-admin-password
NPM_PROXY=
