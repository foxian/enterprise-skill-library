# ESL 环境配置模板：复制为 .env 后按需修改（.env 不入库，权限 600）。

# ── 秘密（绝不入库）──
# Git Backend 内部管理员的密码，首启 Bootstrap（gitea-bootstrap）使用；
# 生产上须同步存入密码管理器（服务器丢失后恢复需要）。
# 秘密：Bootstrap 拒绝示例值与过短值；最小长度见 ESL_PASSWORD_MIN_LENGTH。
GITEA_ADMIN_PASSWORD=change-this-admin-password

# ── 运行环境 ──
# development（默认）| production。production 触发 Bootstrap Reset 护栏：
# scripts/reset-dev-env.mjs 在生产环境拒绝执行（ADR-0018/0047），
# 生产环境"回到过去"只允许备份/恢复（scripts/prod/backup.sh、restore.sh）。
ESL_ENVIRONMENT=development
# 对外访问地址（单入口，ADR-0004）：Git Backend 的 ROOT_URL 等由此派生。
# 开发默认 http://localhost:3000；生产设为实际对外地址（如 http://<IP>，
# Cloudflare Tunnel 场景使用 https://cloud.enterprise-skills.com；TLS 在
# Cloudflare 边缘终止，局域网内 nginx 仍监听 HTTP。
ESL_SERVER_URL=http://localhost:3000

# ── Cloudflare Tunnel（可选，仅 LAN/生产部署）──
# 复制 docker/cloudflared/config.yml.example 到该目录并填入 tunnel UUID。
# CLOUDFLARED_CONFIG_DIR=/home/<user>/.cloudflared

# ── 持久化与路径 ──
# Base directory for persistent data on the host (bind-mounted into api/gitea/secrets)
# Defaults to ./data (relative to the compose file)
ESL_DATA_DIR=./data
# Container-internal DB path (points into the mounted /data); not a host path
DATABASE_PATH=/data/esl.db
# Bootstrap 生成的内部管理员令牌的容器内路径（自动生成，无需修改）
GITEA_ADMIN_TOKEN_FILE=/bootstrap/gitea-admin-token

# ── 策略与种子 ──
ESL_PASSWORD_MIN_LENGTH=8
# Seed sample skill metadata (@myorg/my-skill) at API startup; development only,
# 生产保持 false（干净启动，见 ADR-0018）
ESL_AUTO_SEED=false
# 用于保护注册待验账号密码的邮件动作密钥；生产环境必须使用稳定随机值，
# 修改后已发出的注册验证链接将无法解密。不要提交真实密钥。
ESL_EMAIL_ACTION_SECRET=change-this-to-a-long-random-secret

# ── 构建网络（仅镜像构建期）──
# 构建容器时 npm 走的代理（如 http://host.docker.internal:7890），直连留空
NPM_PROXY=
