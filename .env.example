GITEA_ADMIN_USERNAME=eslroot
GITEA_ADMIN_PASSWORD=change-this-admin-password
GITEA_ADMIN_TOKEN_FILE=/bootstrap/gitea-admin-token
# Base directory for persistent data on the host (bind-mounted into api/gitea/secrets)
# Defaults to ./data (relative to the compose file)
ESL_DATA_DIR=./data
# Container-internal DB path (points into the mounted /data); not a host path
DATABASE_PATH=/data/esl.db
ESL_PASSWORD_MIN_LENGTH=12
ESL_APPLICATION_ENCRYPTION_KEY=replace-with-64-hex-characters
# Seed sample skill metadata (@myorg/my-skill) at API startup; set true in development
ESL_AUTO_SEED=false
# Deployment mode (single | multi, default multi). In single mode the platform
# is provisioned directly from the declarations below and rejects public
# organization registration (see docs/adr/0022). Multi mode is the default for
# skill-cloud providers; single mode suits enterprise self-deployment.
ESL_DEPLOYMENT_MODE=multi
# Single-organization bootstrap declarations (required when mode is single):
# the default organization name and its organization-admin initial password.
# ESL_DEFAULT_ORG=acme
# ESL_ORG_ADMIN_PASSWORD=change-this-org-admin-password
NPM_PROXY=
